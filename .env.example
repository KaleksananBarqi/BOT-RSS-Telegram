# Telegram Bot Token (Required)
# Get this from @BotFather
BOT_TOKEN=your_bot_token_here

# Group or Channel ID (Required)
# Use a tool like @RawDataBot or check URL in web telegram to find ID.
# Format: -100xxxxxxxxxx
GROUP_ID=-1001234567890

# Topic ID (Optional)
# If sending to a specific topic in a supergroup
TOPIC_ID=

# User Agent (Optional)
# Custom user agent for RSS fetching
# USER_AGENT=Mozilla/5.0 ...

# System Configuration (Optional)
# DELAY_BETWEEN_POSTS=2
# CHECK_INTERVAL_HOURS=1
# MAX_NEWS_AGE_HOURS=1
# IV_RHASH=
